# ==============================================================================
# DIGITAL LIBRARY & E-BOOK CIRCULATION PORTAL - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' for local development. Never commit '.env' to git!
# ==============================================================================

# Django Security & Core Settings
SECRET_KEY=your-secret-key-placeholder-minimum-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Admin Account Configuration (For one-time initial setup / Render Shell)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password-placeholder

# Email Configuration (Optional - for Password Reset flow)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password-placeholder
DEFAULT_FROM_EMAIL=Digital Library Portal <noreply@digitallibrary.portal>

# Render External Hostname (Configured automatically on Render)
RENDER_EXTERNAL_HOSTNAME=your-service-name.onrender.com
